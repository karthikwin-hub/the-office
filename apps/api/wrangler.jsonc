{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "the-office",
  // The Snilld account, which also holds the snilld.in zone: a Worker's custom domains must be on a zone in its own account.
  "account_id": "2119b403c5ba8599154d482322cf6877",
  "main": "src/index.ts",
  "compatibility_date": "2025-04-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/media/*", "/w/*"]
  },
  // BETTER_AUTH_SECRET is a secret: `infisical run --env=dev -- sh -c 'printf %s "$BETTER_AUTH_SECRET" | wrangler secret put BETTER_AUTH_SECRET'`.
  // Social channels are optional secrets, put the same way: SOCIAL_TOKEN_KEY, then per platform META_APP_ID/SECRET, META_VERIFY_TOKEN,
  // INSTAGRAM_APP_ID/SECRET, THREADS_APP_ID/SECRET, WHATSAPP_TOKEN, WHATSAPP_PHONE_NUMBER_ID, WHATSAPP_TEMPLATE, LINKEDIN_CLIENT_ID/SECRET, X_CLIENT_ID/SECRET.
  "vars": {
    "DATA_MODE": "live",
    // Sent through Resend (secret RESEND_API_KEY), where snilldai.com is verified; the same address Clubs and Sports OS use.
    "MAIL_FROM": "support@snilldai.com",
    // Each office gets <slug>@INGEST_DOMAIN; an Email Routing catch-all on this domain sends its mail to the Worker.
    "INGEST_DOMAIN": "in.office.snilld.in",
    // Where businesses sign in and choose an office. The bare APP_DOMAIN is the product page, console.APP_DOMAIN is the
    // platform owners' console, and an office with a subdomain opens on <subdomain>.APP_DOMAIN.
    "BETTER_AUTH_URL": "https://app.office.snilld.in",
    "APP_DOMAIN": "office.snilld.in",
    // Who may use the console's view of every business: comma-separated, each must sign in with a confirmed address.
    "PLATFORM_OWNERS": "puja@snilldai.com, appforge.3b@gmail.com"
    // The daily copy of the books on servers in India (Companies (Accounts) Rules, rule 3(5)): add INDIA_BACKUP_ENDPOINT,
    // INDIA_BACKUP_BUCKET and INDIA_BACKUP_REGION here for an S3-compatible bucket in an Indian region, and put
    // INDIA_BACKUP_ACCESS_KEY_ID and INDIA_BACKUP_SECRET_ACCESS_KEY as secrets. Until then the backup is skipped and Settings says so.
  },
  // A deploy replaces the Worker's custom domains with exactly this list, so every customer's address must be here.
  "routes": [
    { "pattern": "office.snilld.in", "custom_domain": true },
    { "pattern": "app.office.snilld.in", "custom_domain": true },
    { "pattern": "console.office.snilld.in", "custom_domain": true },
    // customers: one line each, added by `node tools/admin/admin.mjs subdomain <office> <label>`
    // customers end
  ],
  // Nightly, offices deleted more than 30 days ago are purged.
  "triggers": { "crons": ["30 21 * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "office",
      "database_id": "1dcab657-2ec3-44ff-858a-a5067350c665",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [{ "binding": "DOCS", "bucket_name": "office-docs" }],
  "ai": { "binding": "AI" },
  // One Office per business holds its books and is their only writer; its own alarms run the morning round.
  "durable_objects": { "bindings": [{ "name": "Office", "class_name": "Office" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Office"] }],
  // Delivers only to addresses verified in Email Routing on the account.
  "send_email": [{ "name": "MAILER" }],
  // The website chat: 20 messages a minute for one visitor's address on one office's chat.
  // On live both TURNSTILE_SECRET (a secret) and TURNSTILE_SITE_KEY (a plain var) are required; without them the website chat answers 503.
  "ratelimits": [{ "name": "CHAT_LIMIT", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } }],
  // Workers Logs, on the free plan: 200,000 log events a day for the account, kept 3 days. Each invocation (of the Worker
  // or an office) writes one log; the code adds a line only when something fails and for the nightly duties
  // (apps/api/src/log.ts), so nothing is sampled away. Query strings are left out of the invocation logs: an OAuth
  // callback's code, a media link's signature and a chat visitor's id are not kept. Issues groups the error lines for
  // the alerts in docs/handbook/04-deployment.md, section 9. Inherited by env.staging.
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "redact_query_string": true,
    "logs": { "enabled": true, "invocation_logs": true },
    "issues": { "enabled": true }
  },
  // Staging: `--env staging`, deployed by `tools/admin/deploy.sh staging` and by .github/workflows/deploy.yml on every push
  // to main. A Worker of its own with its own D1, R2, offices (Durable Objects), rate-limit counters and secrets: nothing
  // here may name a live resource. It lives on workers.dev, a different site from office.snilld.in, so the live sign-in
  // cookie (set for office.snilld.in) never reaches it. Bindings are not inherited from the top level, so each is listed.
  // Fill in every REPLACE_WITH_ value (docs/handbook/04-deployment.md, section 7); deploy.sh refuses while one is left.
  "env": {
    "staging": {
      "name": "the-office-staging",
      // A separate free Cloudflare account keeps staging's traffic off live's daily free-plan allowance and its token
      // away from live. The Snilld account's id also works, with a token that can reach live.
      "account_id": "REPLACE_WITH_STAGING_ACCOUNT_ID",
      // Routes are inherited: without this empty list staging would claim live's custom domains.
      "routes": [],
      "workers_dev": true,
      "preview_urls": false,
      "vars": {
        "DATA_MODE": "live",
        // Sign-up confirms the address by mail: give staging its own sending-only RESEND_API_KEY, never live's. Without one,
        // mail goes through MAILER, which needs Email Routing on a zone in this account and reaches only verified addresses.
        "MAIL_FROM": "support@snilldai.com",
        // No Email Routing points here, so staging receives no mail until a catch-all is added for this domain.
        "INGEST_DOMAIN": "in.staging.office.snilld.in",
        "BETTER_AUTH_URL": "https://the-office-staging.REPLACE_WITH_WORKERS_DEV_SUBDOMAIN.workers.dev",
        // Empty: everything is on one host, the console at /?platform, and the sign-in cookie is for this host only.
        "APP_DOMAIN": "",
        "PLATFORM_OWNERS": "puja@snilldai.com, appforge.3b@gmail.com"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "office-staging",
          "database_id": "REPLACE_WITH_STAGING_D1_ID",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [{ "binding": "DOCS", "bucket_name": "office-docs-staging" }],
      "ai": { "binding": "AI" },
      // A class in another Worker is another namespace: staging's offices are not live's.
      "durable_objects": { "bindings": [{ "name": "Office", "class_name": "Office" }] },
      "send_email": [{ "name": "MAILER" }],
      // Its own namespace id, so staging's chat traffic does not count against live's limit.
      "ratelimits": [{ "name": "CHAT_LIMIT", "namespace_id": "1002", "simple": { "limit": 20, "period": 60 } }]
    }
  }
}
