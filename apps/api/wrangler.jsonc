{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "the-office",
  // The Snilld account, which also holds the snilld.in zone: a Worker's custom domains must be on a zone in its own account.
  "account_id": "SNILLD_ACCOUNT_ID",
  "main": "src/index.ts",
  "compatibility_date": "2025-04-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/media/*", "/w/*"]
  },
  // BETTER_AUTH_SECRET is a secret: `infisical run --env=dev -- sh -c 'printf %s "$BETTER_AUTH_SECRET" | wrangler secret put BETTER_AUTH_SECRET'`.
  // Social channels are optional secrets, put the same way: SOCIAL_TOKEN_KEY, then per platform META_APP_ID/SECRET, META_VERIFY_TOKEN,
  // INSTAGRAM_APP_ID/SECRET, THREADS_APP_ID/SECRET, WHATSAPP_TOKEN, WHATSAPP_PHONE_NUMBER_ID, WHATSAPP_TEMPLATE, LINKEDIN_CLIENT_ID/SECRET, X_CLIENT_ID/SECRET.
  "vars": {
    "DATA_MODE": "live",
    "MAIL_FROM": "office@mail.office.snilld.in",
    // Each office gets <slug>@INGEST_DOMAIN; an Email Routing catch-all on this domain sends its mail to the Worker.
    "INGEST_DOMAIN": "in.office.snilld.in",
    // The console, where people sign in. The bare APP_DOMAIN is the product page; an office with a subdomain opens on <subdomain>.APP_DOMAIN.
    "BETTER_AUTH_URL": "https://console.office.snilld.in",
    "APP_DOMAIN": "office.snilld.in"
  },
  // A deploy replaces the Worker's custom domains with exactly this list, so every customer's address must be here.
  "routes": [
    { "pattern": "office.snilld.in", "custom_domain": true },
    { "pattern": "console.office.snilld.in", "custom_domain": true },
    // customers: one line each, added by `node tools/admin/admin.mjs subdomain <office> <label>`
    // customers end
  ],
  // Nightly, offices deleted more than 30 days ago are purged.
  "triggers": { "crons": ["30 21 * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "office",
      "database_id": "SNILLD_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [{ "binding": "DOCS", "bucket_name": "office-docs" }],
  "ai": { "binding": "AI" },
  // One Office per business holds its books and is their only writer; its own alarms run the morning round.
  "durable_objects": { "bindings": [{ "name": "Office", "class_name": "Office" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Office"] }],
  // Delivers only to addresses verified in Email Routing on the account.
  "send_email": [{ "name": "MAILER" }],
  // The website chat: 20 messages a minute for one visitor's address on one office's chat.
  // TURNSTILE_SECRET is an optional secret; TURNSTILE_SITE_KEY, when set, is a plain var.
  "ratelimits": [{ "name": "CHAT_LIMIT", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } }],
  "observability": { "enabled": true }
}
