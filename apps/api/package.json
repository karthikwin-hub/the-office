{
  "name": "@office/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler d1 migrations apply office --local && infisical run --env=dev -- sh -c 'wrangler dev --var BETTER_AUTH_SECRET:\"$BETTER_AUTH_SECRET\" --var BETTER_AUTH_URL:http://localhost:8787'",
    "deploy": "wrangler deploy",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply office --local",
    "db:migrate": "wrangler d1 migrations apply office --remote",
    "test": "vitest run",
    "typecheck": "tsc -p ."
  },
  "dependencies": {
    "@office/contracts": "workspace:*",
    "@office/engine": "workspace:*",
    "@office/fixtures": "workspace:*",
    "agents": "^0.0.113",
    "better-auth": "1.2.12",
    "drizzle-orm": "^0.41.0",
    "hono": "^4.7.5",
    "postal-mime": "^2.4.3",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250405.0",
    "drizzle-kit": "^0.30.6",
    "vitest": "^3.0.5",
    "wrangler": "^4.10.0"
  }
}
